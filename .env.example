# ---------------------------------------------------------------------------
# Guardian — environment variables
# Every one of these is OPTIONAL. With none of them set, the app runs fully:
# payments use a mock adapter and Guardian AI uses a deterministic answerer.
# ---------------------------------------------------------------------------

# Razorpay TEST MODE only. The adapter refuses any key that does not start with
# "rzp_test_", so a live key cannot be used by accident. Even in test mode no
# real money moves — an order object is created and nothing is captured.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Enables LLM-written answers in Guardian AI. Without it the assistant falls
# back to a rules-based answerer that reads the same data, so the demo never
# depends on a network call. The chat route can only return text either way.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
